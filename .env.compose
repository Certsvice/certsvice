# Copy this file to .env and fill in your values before running docker compose.
#
# ── Local Hardhat (no ETH needed) ─────────────────────────────────────────
#   docker compose --profile local up --build
#   Contract is auto-deployed; address is written to a shared volume at runtime.
#   MetaMask custom RPC: http://localhost:8545  |  Chain ID: 31337
#   CONTRACT_ADDRESS and BLOCKCHAIN_RPC_URL can be left empty for local.
#
# ── Sepolia Testnet ────────────────────────────────────────────────────────
#   Step 1 – deploy contract (runs once, writes address to shared volume):
#     docker compose --profile sepolia run --rm contract-deploy-sepolia
#   Step 2 – fill in CONTRACT_ADDRESS below (printed in step 1 logs), then:
#     docker compose up --build
# --------------------------------------------------------------------------

# ── API ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXP=24

# Sepolia only — leave empty for local Hardhat (auto-filled at runtime)
CONTRACT_ADDRESS=
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# ── Back Office ───────────────────────────────────────────────────────────
# URL of the API as seen from the USER'S BROWSER (not from inside Docker).
# Local: http://localhost:8080   |   Server: https://your-domain.com
NEXT_PUBLIC_API_URI=http://localhost:8080

# ── Sepolia Deployer ──────────────────────────────────────────────────────
# Required only when running: docker compose --profile sepolia run contract-deploy-sepolia
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
DEPLOYER_PRIVATE_KEY=your-wallet-private-key-without-0x-prefix
